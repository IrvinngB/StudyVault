{
  "expo": {
    "name": "StudyVault",
    "slug": "StudyVault",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/android/mipmap-xxxhdpi/StudyVaultLOGO.png",
    "scheme": "studyvault",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "icon": "./assets/Assets.xcassets/AppIcon.appiconset/1024.png",
      "bundleIdentifier": "com.irvinng04.StudyVault"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/android/mipmap-xxxhdpi/StudyVaultLOGO.png",
        "backgroundColor": "#ffffff"
      },
      "icon": "./assets/android/mipmap-xxxhdpi/StudyVaultLOGO.png",
      "edgeToEdgeEnabled": true,
      "package": "com.irvinng04.StudyVault"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/android/mipmap-xxxhdpi/StudyVaultLOGO.png",
          "imageWidth": 150,
          "resizeMode": "contain",
          "backgroundColor": "#E8B54A",
          "dark": {
            "image": "./assets/android/mipmap-xxxhdpi/StudyVaultLOGO.png",
            "backgroundColor": "#8B4513"
          }
        }
      ],
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "37f71a34-a9a3-4376-8ae2-3ea1959d2ec0"
      }
    }
  }
}
