{
  "expo": {
    "name": "StudyVault",
    "slug": "StudyVault",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/Assets.xcassets/AppIcon.appiconset/1024.png",
    "scheme": "studyvault",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "icon": "./assets/Assets.xcassets/AppIcon.appiconset/1024.png",
      "bundleIdentifier": "com.studyteam.StudyVault"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/Assets.xcassets/AppIcon.appiconset/512.png",
        "backgroundColor": "#2563EB"
      },
      "icon": "./assets/Assets.xcassets/AppIcon.appiconset/512.png",
      "edgeToEdgeEnabled": true,
      "package": "com.studyteam.StudyVault",
      "allowBackup": false
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/Assets.xcassets/AppIcon.appiconset/32.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/Assets.xcassets/AppIcon.appiconset/1024.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#0F172A",
          "dark": {
            "image": "./assets/Assets.xcassets/AppIcon.appiconset/1024.png",
            "backgroundColor": "#0F172A"
          }
        }
      ],
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "37f71a34-a9a3-4376-8ae2-3ea1959d2ec0"
      }
    }
  }
}